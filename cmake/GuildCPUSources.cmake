# Canonical CPU source/ISA ownership for embedding the validated baseline.
# This file does not read Guild's private source tree or run a nested project.
function(guild_cpu_attach_base target arithmetic)
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  target_include_directories(${target} PUBLIC "${root}/include")
  target_sources(${target} PRIVATE "${root}/src/kernels/cpu/features.cpp" "${root}/src/kernels/cpu/isa.cpp")
  if(arithmetic)
    target_sources(${target} PRIVATE "${root}/src/kernels/cpu/expert.cpp" "${root}/src/kernels/cpu/q2_avx2.cpp")
    if(MSVC)
      set_source_files_properties("${root}/src/kernels/cpu/expert.cpp" PROPERTIES COMPILE_OPTIONS /arch:AVX512)
      set_source_files_properties("${root}/src/kernels/cpu/q2_avx2.cpp" PROPERTIES COMPILE_OPTIONS /arch:AVX2)
    else()
      set_source_files_properties("${root}/src/kernels/cpu/expert.cpp" PROPERTIES COMPILE_OPTIONS "-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma")
      set_source_files_properties("${root}/src/kernels/cpu/q2_avx2.cpp" PROPERTIES COMPILE_OPTIONS "-mavx2;-mfma;-mf16c")
    endif()
  else()
    target_compile_definitions(${target} PRIVATE GUILD_CPU_PROBE_ONLY=1)
  endif()
endfunction()

function(guild_cpu_attach_native target)
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  target_sources(${target} PRIVATE "${root}/src/backend.cpp" "${root}/src/vector_ops.cpp")
  foreach(name native_expert iq_avx512 iq_avx2 kq_avx2 kq_avx1 canonical_avx2)
    target_sources(${target} PRIVATE "${root}/src/kernels/cpu/${name}.cpp")
  endforeach()
  target_include_directories(${target} PRIVATE "${root}/third_party/ggml")
  if(MSVC)
    set_source_files_properties("${root}/src/kernels/cpu/iq_avx512.cpp" PROPERTIES COMPILE_OPTIONS /arch:AVX512)
    set(avx2 /arch:AVX2)
    set(avx1 /arch:AVX)
  else()
    set_source_files_properties("${root}/src/kernels/cpu/iq_avx512.cpp" PROPERTIES COMPILE_OPTIONS "-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma")
    set(avx2 "-mavx2;-mfma;-mf16c")
    set(avx1 -mavx)
  endif()
  foreach(name iq_avx2 kq_avx2 canonical_avx2)
    set_source_files_properties("${root}/src/kernels/cpu/${name}.cpp" PROPERTIES COMPILE_OPTIONS "${avx2}")
  endforeach()
  set_source_files_properties("${root}/src/kernels/cpu/kq_avx1.cpp" PROPERTIES COMPILE_OPTIONS "${avx1}")
endfunction()
